{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "question",
    "kind",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "id": {
      "type": "string",
      "pattern": "^int_[0-9a-f]{32}$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "one_time_research",
        "recurring"
      ]
    },
    "status": {
      "enum": [
        "queued",
        "researching",
        "completed",
        "failed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "deliver_after": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "evidence_pack_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
