{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "intent_id",
    "summary",
    "findings",
    "sources",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "intent_id": {
      "type": "string",
      "pattern": "^int_[0-9a-f]{32}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "source_ids"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "uncertainty": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_quote": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": [
              "string",
              "null"
            ]
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "source_type": {
            "enum": [
              "primary",
              "secondary_reporting",
              "search_snippet",
              "unknown"
            ]
          },
          "access_status": {
            "enum": [
              "full",
              "partial",
              "paywalled",
              "unavailable",
              "not_attempted"
            ]
          },
          "verification": {
            "enum": [
              "checked_extracted_text",
              "checked_original_document",
              "unverified"
            ]
          },
          "original_source_accessed": {
            "type": "boolean"
          },
          "accessed_at": {
            "type": "string",
            "minLength": 1
          },
          "extracted_text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "research_completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "blocked"
          ]
        },
        "answered": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unverified": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
